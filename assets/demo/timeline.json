{
  "duration": 56.0,
  "shots": [
    {
      "at": 0,
      "until": 5,
      "title": "走进鄱阳湖",
      "text": "这里是《鄱阳归翎》。把湖泊治理，化作卡牌策略。",
      "action": "menu",
      "focus": [
        640,
        360
      ],
      "zoom": 1.02
    },
    {
      "at": 5,
      "until": 10,
      "title": "一湖生态，彼此相连",
      "text": "在四季轮转中，平衡生态与社区发展。",
      "action": "start",
      "focus": [
        640,
        360
      ],
      "zoom": 1.06
    },
    {
      "at": 10,
      "until": 16,
      "title": "先读懂生态监测",
      "text": "先读懂右侧的生态监测。水位、植被、水质与鱼鸟，彼此影响。",
      "action": "monitor",
      "focus": [
        1120,
        265
      ],
      "zoom": 1.52
    },
    {
      "at": 16,
      "until": 24,
      "title": "把经费用在刀刃上",
      "text": "选择执法巡逻，调整投入强度。将卡牌向上拖出。在已打出区，看清牌面与费用。卡牌自动归入待执行区。",
      "action": "choose",
      "focus": [
        445,
        570
      ],
      "zoom": 1.15
    },
    {
      "at": 24,
      "until": 31,
      "title": "让选择产生变化",
      "text": "执行行动，卡牌逐张结算。指标随之变化，让收益与代价看得见。",
      "action": "settle",
      "focus": [
        850,
        335
      ],
      "zoom": 1.26
    },
    {
      "at": 31,
      "until": 41,
      "title": "危机与应对",
      "text": "极端干旱来袭，湖区拉响警报。选择生态补水，及时应对。缓解水位下降带来的压力。",
      "action": "crisis",
      "focus": [
        640,
        350
      ],
      "zoom": 1.1
    },
    {
      "at": 41,
      "until": 49,
      "title": "在游玩中认识湿地",
      "text": "白鹤知识卡，呈现真实的湿地物种。读懂它与湖泊的联系，在游玩中认识自然。",
      "action": "knowledge",
      "focus": [
        640,
        360
      ],
      "zoom": 1.18
    },
    {
      "at": 49,
      "until": 56,
      "title": "让守护继续",
      "text": "监测、决策、应对危机。让一湖清水，等待万物归来。",
      "action": "closing",
      "focus": [
        640,
        355
      ],
      "zoom": 1
    }
  ],
